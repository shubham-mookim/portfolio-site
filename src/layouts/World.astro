---
import { ClientRouter } from 'astro:transitions';
import Axis from '../components/Axis.astro';
import Readout from '../components/Readout.astro';
import { me } from '../data/site';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  world?: 'below' | 'above' | 'surface';
  /** −1 high above water · 0 the waterline · +1 the abyss */
  depth?: number;
  /** how much further the axis travels as you scroll the page */
  drift?: number;
  /** "axis" = the home page, where the waterline sits mid-scroll and you can
      travel up into air or down into the deep from it */
  mode?: 'page' | 'axis';
}

const {
  title,
  description = 'Shubham Mookim — research engineer building multi-agent AI systems for precision oncology at ForGood.ai. Bengaluru, India.',
  world = 'surface',
  depth = 0,
  drift = 0.12,
  mode = 'page',
} = Astro.props;

const full = title === 'Surface' ? `${me.name} — ${me.role}` : `${title} — ${me.name}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="author" content={me.name} />
  <meta name="theme-color" content={world === 'above' ? '#efe7db' : '#041018'} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Instrument+Serif:ital@0;1&display=swap"
    rel="stylesheet"
  />
  <link
    rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23041018'/><path d='M0 54c14-9 22 9 34 0s20 9 34 0 22 6 32 0' stroke='%2363e6d2' stroke-width='7' fill='none'/></svg>"
  />
  <ClientRouter />
</head>

<body data-world={world} data-depth={depth} data-drift={drift} data-mode={mode}>
  <canvas id="world" aria-hidden="true" transition:persist="world"></canvas>
  <div class="veil" aria-hidden="true" transition:persist="veil"></div>
  <div class="topfade" aria-hidden="true"></div>

  <Axis world={world} />

  <main class="shell" id="top">
    <slot />
  </main>

  <Readout />

  <footer class="shell">
    <span>© 2026 {me.name}</span>
    <span class="foot-mid">
      <a href={me.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={`mailto:${me.email}`}>Email ↗</a>
    </span>
    <a href="/colophon/">How this site is made ↗</a>
  </footer>

  <script>
    import { Water } from '../scripts/water.js';

    let base = 0, drift = 0, raf = null, axisMode = false;

    /* how far above the waterline the home page can climb, and how far below it
       can sink before you are expected to open the deep properly */
    const AIR = 0.62, DIVE = 0.55;

    function progress() {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return max > 40 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    }

    /* the home page maps scroll onto a signed axis with the waterline in the middle */
    function axisDepth() {
      const line = document.getElementById('waterline');
      if (!line) return 0;
      const zero = line.offsetTop;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const y = window.scrollY;
      if (zero <= 0 || max <= zero) return 0;
      return y < zero
        ? -AIR * (1 - y / zero)
        :  DIVE * ((y - zero) / (max - zero));
    }

    function paint() {
      raf = null;
      const d = axisMode ? axisDepth() : base + drift * progress();
      Water.depth = d;
      document.dispatchEvent(new CustomEvent('axis', { detail: { depth: d, t: progress() } }));
    }

    function onScroll() {
      if (!raf) raf = requestAnimationFrame(paint);
      document.body.classList.toggle('scrolled', window.scrollY > 24);
    }

    function sync() {
      const canvas = document.getElementById('world');
      if (!canvas) return;
      base = parseFloat(document.body.dataset.depth || '0');
      drift = parseFloat(document.body.dataset.drift || '0');
      axisMode = document.body.dataset.mode === 'axis';

      if (!Water.live) Water.init(canvas, { depth: base });

      /* On the home page the waterline is the resting position, not the top of
         the document — land there so "up" and "down" both mean something. */
      if (axisMode) {
        const line = document.getElementById('waterline');
        if (line && !location.hash) {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          window.scrollTo({ top: line.offsetTop, behavior: 'instant' });
          Water.jump(0);
        }
      }
      paint();
    }

    // reveal-on-approach, re-armed after every navigation
    function rise() {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-rise]:not(.in)').forEach((n) => io.observe(n));

      const lit = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('lit', e.isIntersecting)),
        { threshold: 0.3 }
      );
      document.querySelectorAll('.specimen, .plate').forEach((n) => lit.observe(n));

      // the depth readout steps aside rather than colliding with the footer
      const foot = document.querySelector('footer');
      const ro = document.querySelector('.readout');
      if (foot && ro) {
        new IntersectionObserver(
          ([e]) => ro.classList.toggle('tuck', e.isIntersecting),
          { rootMargin: '0px 0px -12px 0px' }
        ).observe(foot);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', () => {
      sync();
      rise();
    });
  </script>
</body>
</html>
